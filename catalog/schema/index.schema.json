{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-connector-hub.local/schema/index.schema.json",
  "title": "Connector Hub catalog index",
  "type": "object",
  "required": ["schemaVersion", "revision", "connectors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"
    },
    "connectors": {
      "type": "array",
      "items": {
        "$ref": "https://dsh-connector-hub.local/schema/connector.schema.json"
      }
    }
  }
}
