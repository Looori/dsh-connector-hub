{
  "name": "dsh-connector-hub",
  "version": "0.0.0",
  "description": "Community connector hub for DeepSeek Harness; not an official DeepSeek product.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "catalog/index.json",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@napi-rs/keyring": "^1.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.9.3"
  }
}
